// MARK: File preview (download + Quick Look)

struct TeamsFilePreview: View {
    let item: TGItem
    let drive: String
    @EnvironmentObject var hub: TeamsHub
    @State private var local: URL?
    @State private var error: String?

    var body: some View {
        Group {
            if let u = local { QuickLookView(url: u) }
            else if let e = error {
                VStack(spacing: 14) {
                    Text(e).font(.footnote).foregroundColor(Theme.muted).multilineTextAlignment(.center)
                    if let w = item.webUrl, let url = URL(string: w) {
                        Link(destination: url) {
                            Label("Open in browser", systemImage: "safari").fontWeight(.semibold)
                                .foregroundColor(Theme.accent)
                        }
                    }
                }.padding(24).frame(maxWidth: .infinity, maxHeight: .infinity)
            } else {
                ProgressView().tint(Theme.accent).frame(maxWidth: .infinity, maxHeight: .infinity)
            }
        }
        .background(Theme.bg.ignoresSafeArea())
        .navigationTitle(item.name)
        .navigationBarTitleDisplayMode(.inline)
        .toolbar {
            if let u = local {
                ToolbarItem(placement: .navigationBarTrailing) { ShareLink(item: u) }
            }
        }
        .task { await download() }
    }

    private func download() async {
        do {
            var dl = item.downloadUrl
            if dl == nil {
                let fresh: TGItem = try await hub.graph("/drives/\(hub.enc(drive))/items/\(hub.enc(item.id))", TGItem.self)
                dl = fresh.downloadUrl
            }
            guard let s = dl, let url = URL(string: s) else { throw TeamsError.http(404) }
            let (tmp, _) = try await URLSession.shared.download(from: url)
            let dir = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
            try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
            let dest = dir.appendingPathComponent(item.name)
            try FileManager.default.moveItem(at: tmp, to: dest)
            local = dest
        } catch {
            self.error = "Couldn't open this file. \(error.localizedDescription)"
        }
    }
}

// MARK: Work (assignments)

struct TeamsWorkTab: View {
    let teamId: String
    @EnvironmentObject var hub: TeamsHub
