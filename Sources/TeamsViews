enum TeamsFolderSource: Hashable {
    case channel(team: String, channel: String)
    case item(drive: String, id: String)
}

@MainActor
final class TeamsFolderModel: ObservableObject {
    @Published var items: [TGItem] = []
    @Published var drive = ""
    @Published var loading = true
    @Published var error: String?

    func load(_ s: TeamsFolderSource, hub: TeamsHub) async {
        loading = true; error = nil
        do {
            var driveId: String, itemId: String
            switch s {
            case .channel(let t, let c):
                let f: TGItem = try await hub.graph("/teams/\(hub.enc(t))/channels/\(hub.enc(c))/filesFolder", TGItem.self)
                driveId = f.parentReference?.driveId ?? ""
                itemId = f.id
            case .item(let d, let i):
                driveId = d; itemId = i
            }
            drive = driveId
            let list = try await hub.graphAll("/drives/\(hub.enc(driveId))/items/\(hub.enc(itemId))/children?$top=200", TGItem.self)
            items = list.sorted {
                if $0.isFolder != $1.isFolder { return $0.isFolder }
                return $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending
            }
        } catch {
            self.error = error.localizedDescription
        }
        loading = false
    }
}

struct TeamsFolderView: View {
    let source: TeamsFolderSource
    let title: String
    @EnvironmentObject var hub: TeamsHub
    @StateObject private var model = TeamsFolderModel()

    var body: some View {
        ScrollView {
            VStack(spacing: 0) {
                if model.loading { ProgressView().tint(Theme.accent).padding(.top, 30) }
                else if let e = model.error { TeamsInfo(text: e) }
                else if model.items.isEmpty { TeamsInfo(text: "This folder is empty.") }
                else {
                    VStack(spacing: 0) {
                        ForEach(model.items) { it in
                            if it.isFolder {
                                NavigationLink {
                                    TeamsFolderView(source: .item(drive: model.drive, id: it.id), title: it.name)
                                } label: {
                                    TeamsFileRow(icon: "folder.fill", title: it.name,
                                                 subtitle: "\(it.folder?.childCount ?? 0) items")
                                }
                                .buttonStyle(.plain)
                            } else {
                                NavigationLink {
                                    TeamsFilePreview(item: it, drive: model.drive)
                                } label: {
                                    TeamsFileRow(icon: teamsIcon(it.name), title: it.name,
                                                 subtitle: teamsSub(it))
                                }
                                .buttonStyle(.plain)
                            }
                        }
                    }
                    .glowCard()
                    .padding(16)
                }
            }
        }
        .background(Theme.bg.ignoresSafeArea())
        .navigationTitle(title)
        .navigationBarTitleDisplayMode(.inline)
        .refreshable { await model.load(source, hub: hub) }
        .task { await model.load(source, hub: hub) }
    }

    private func teamsSub(_ it: TGItem) -> String {
        var parts: [String] = []
        if let s = it.size { parts.append(ByteCountFormatter.string(fromByteCount: Int64(s), countStyle: .file)) }
        let d = tgDate(it.lastModifiedDateTime)
        if d != "-" { parts.append(d) }
        return parts.joined(separator: " · ")
    }
}

func teamsIcon(_ name: String) -> String {
    switch (name as NSString).pathExtension.lowercased() {
    case "pdf": return "doc.richtext"
    case "ppt", "pptx": return "rectangle.on.rectangle"
    case "xls", "xlsx", "csv": return "tablecells"
    case "doc", "docx", "txt", "rtf": return "doc.text"
    case "png", "jpg", "jpeg", "gif", "heic": return "photo"
    case "mp4", "mov", "m4v": return "play.rectangle"
    case "mp3", "m4a", "wav": return "waveform"
    case "zip", "rar": return "archivebox"
    default: return "doc"
    }
}

