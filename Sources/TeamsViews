// MARK: - Link to a course

struct TeamLinkSheet: View {
    let team: TGTeam
    @EnvironmentObject var hub: TeamsHub
    @EnvironmentObject var catalog: CourseCatalog
    @Environment(\.dismiss) private var dismiss

    var body: some View {
        NavigationStack {
            ScrollView {
                VStack(alignment: .leading, spacing: 12) {
                    Text("“\(team.displayName)” will show a Teams icon on the course you pick.")
                        .font(.footnote).foregroundColor(Theme.muted)
                    if catalog.courses.isEmpty {
                        Text(catalog.loaded ? "No courses found." : "Loading courses…")
                            .foregroundColor(Theme.muted).padding(.top, 20)
                    } else {
                        VStack(spacing: 0) {
                            ForEach(catalog.courses) { c in
                                let on = hub.courseId(forTeam: team.id) == c.id
                                Button {
                                    if on { hub.unlink(teamId: team.id) } else { hub.link(team, to: c.id) }
                                    dismiss()
                                } label: {
                                    HStack(spacing: 12) {
                                        Image(systemName: on ? "checkmark.circle.fill" : "circle")
                                            .foregroundColor(on ? Theme.accent : Theme.muted)
                                        VStack(alignment: .leading, spacing: 2) {
                                            Text(c.subjectName).foregroundColor(Theme.txt)
                                                .multilineTextAlignment(.leading)
                                            if let other = hub.linkedTeam(for: c.id), other.teamId != team.id {
                                                Text("Currently: \(other.teamName)")
                                                    .font(.caption).foregroundColor(Theme.muted)
                                            }
                                        }
                                        Spacer()
                                    }
                                    .padding(14).contentShape(Rectangle())
                                    .overlay(Rectangle().fill(Theme.line).frame(height: 1), alignment: .bottom)
                                }
                                .buttonStyle(.plain)
                            }
                        }
                        .glowCard()
                    }
                }
                .padding(16)
            }
            .background(Theme.bg.ignoresSafeArea())
            .navigationTitle("Link to a course")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .navigationBarTrailing) {
                    Button("Cancel") { dismiss() }.fontWeight(.semibold)
                }
            }
        }
        .preferredColorScheme(.dark)
        .task { await catalog.loadIfNeeded() }
    }
}

// MARK: - Class page (opened from the Teams icon on a course, or from Others)

enum TeamsTab: String, CaseIterable, Identifiable {
    case files = "Files", work = "Work", posts = "Posts"
    var id: String { rawValue }
}

struct TeamsClassView: View {
    let team: TeamLink
    @State private var tab: TeamsTab = .files

    var body: some View {
        VStack(spacing: 0) {
            ScrollView(.horizontal, showsIndicators: false) {
                HStack(spacing: 26) {
                    ForEach(TeamsTab.allCases) { t in
                        Button { tab = t } label: {
                            Text(t.rawValue)
                                .fontWeight(tab == t ? .semibold : .regular)
                                .foregroundColor(tab == t ? Theme.accent : Color(white: 0.66))
                        }
                    }
                }
                .padding(.horizontal, 16).padding(.vertical, 12)
            }
            switch tab {
            case .files: TeamsFilesTab(teamId: team.teamId)
            case .work: TeamsWorkTab(teamId: team.teamId)
