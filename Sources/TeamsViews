    @State private var error: String?
    @State private var open: Set<String> = []

    var body: some View {
        ScrollView {
            VStack(spacing: 0) {
                if loading { ProgressView().tint(Theme.accent).padding(.top, 30) }
                else if let e = error { TeamsInfo(text: "Work isn't available for this class. \(e)") }
                else if items.isEmpty { TeamsInfo(text: "No assignments yet.") }
                else {
                    VStack(spacing: 0) {
                        ForEach(items) { a in
                            VStack(alignment: .leading, spacing: 6) {
                                Button {
                                    if open.contains(a.id) { open.remove(a.id) } else { open.insert(a.id) }
                                } label: {
                                    HStack(alignment: .top, spacing: 14) {
                                        Image(systemName: "square.and.pencil").foregroundColor(Theme.accent).frame(width: 26)
                                        VStack(alignment: .leading, spacing: 3) {
                                            Text(a.displayName).foregroundColor(Theme.txt).fontWeight(.semibold)
                                                .multilineTextAlignment(.leading)
