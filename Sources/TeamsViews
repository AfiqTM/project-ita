                                                .font(.caption).foregroundColor(Theme.muted)
                                        }
                                        Spacer()
                                        Image(systemName: open.contains(a.id) ? "chevron.up" : "chevron.down")
                                            .font(.caption).foregroundColor(Theme.muted)
                                    }
                                }
                                .buttonStyle(.plain)
                                if open.contains(a.id) {
                                    let t = (a.instructions?.content ?? "").plainText
                                    Text(t.isEmpty ? "No instructions." : t)
                                        .font(.footnote).foregroundColor(Theme.txt).padding(.leading, 40)
                                }
                            }
                            .padding(14)
                            .frame(maxWidth: .infinity, alignment: .leading)
                            .overlay(Rectangle().fill(Theme.line).frame(height: 1), alignment: .bottom)
                        }
                    }
                    .glowCard()
                    .padding(16)
                }
            }
        }
        .background(Theme.bg.ignoresSafeArea())
        .task(id: teamId) {
            loading = true; error = nil
            do {
                items = try await hub.graphAll("/education/classes/\(hub.enc(teamId))/assignments?$top=50", TGAssignment.self)
                    .sorted { ($0.dueDateTime ?? "") > ($1.dueDateTime ?? "") }
            } catch { self.error = error.localizedDescription }
            loading = false
        }
    }
}

// MARK: Posts (channel conversations)

struct TeamsPostsTab: View {
    let teamId: String
    @EnvironmentObject var hub: TeamsHub
    @State private var channels: [TGChannel] = []
    @State private var picked: TGChannel?
    @State private var posts: [TGMessage] = []
    @State private var loading = true
    @State private var error: String?

    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 12) {
                if channels.count > 1 {
                    ScrollView(.horizontal, showsIndicators: false) {
                        HStack(spacing: 8) {
                            ForEach(channels) { c in
                                Button { picked = c } label: {
                                    Text(c.displayName).font(.footnote.weight(.semibold))
                                        .foregroundColor(picked == c ? .black : Theme.txt)
                                        .padding(.horizontal, 12).padding(.vertical, 6)
                                        .background(picked == c ? Theme.accent : Theme.surface2)
                                        .clipShape(Capsule())
                                }
                            }
                        }
                    }
                }
                if loading { ProgressView().tint(Theme.accent).frame(maxWidth: .infinity).padding(.top, 30) }
                else if let e = error { TeamsInfo(text: "Posts can't be shown here. \(e)") }
                else if posts.isEmpty { TeamsInfo(text: "No posts.") }
                else {
                    VStack(spacing: 0) {
                        ForEach(posts) { m in
                            VStack(alignment: .leading, spacing: 4) {
                                Text(m.from?.user?.displayName ?? "Teams").fontWeight(.semibold).foregroundColor(Theme.txt)
                                Text(tgDate(m.createdDateTime)).font(.caption).foregroundColor(Theme.muted)
                                let body = (m.body?.content ?? "").plainText
                                if !body.isEmpty { Text(body).font(.footnote).foregroundColor(Theme.txt).padding(.top, 2) }
                            }
                            .padding(14)
                            .frame(maxWidth: .infinity, alignment: .leading)
                            .overlay(Rectangle().fill(Theme.line).frame(height: 1), alignment: .bottom)
                        }
                    }
                    .glowCard()
                }
            }
            .padding(16)
        }
        .background(Theme.bg.ignoresSafeArea())
        .task(id: teamId) {
            do {
                channels = try await hub.channels(teamId)
                picked = channels.first
            } catch { self.error = error.localizedDescription; loading = false }
        }
        .task(id: picked) {
            guard let c = picked else { return }
            loading = true; error = nil
            do {
                let r: TGList<TGMessage> = try await hub.graph(
                    "/teams/\(hub.enc(teamId))/channels/\(hub.enc(c.id))/messages?$top=30", TGList<TGMessage>.self)
                posts = r.value.filter { !($0.body?.content ?? "").isEmpty }
            } catch { self.error = error.localizedDescription }
            loading = false
        }
    }
}
