@@ -0,0 +1,184 @@
+import SwiftUI
+
+// MARK: - Groups tab (course page)
+//
+// Groups and their members come from core_enrol_get_enrolled_users, which already lists the groups of every
+// participant, so no extra web-service permission is needed. Creating, editing and deleting groups (and the
+// overview / auto-create pages) are the website's own screens, opened already logged in; the site decides
+// what your role may do there.
+
+struct CourseGroupInfo: Identifiable {
+    let id: Int
+    let name: String
+    let about: String
+    var members: [Person]
+}
+
+struct GroupsView: View {
+    let courseId: Int
+    @EnvironmentObject var app: AppState
+    @State private var people: [Person] = []
+    @State private var query = ""
+    @State private var loading = true
+    @State private var error: String?
+    @State private var open: Set<Int> = []
+
+    private var myId: Int { app.site?.userid ?? 0 }
+
+    private var allGroups: [CourseGroupInfo] {
+        var byId: [Int: CourseGroupInfo] = [:]
+        for p in people {
+            for g in p.groups ?? [] {
+                let name = (g.name ?? "Group \(g.id)").decodedEntities
+                var info = byId[g.id] ?? CourseGroupInfo(id: g.id, name: name,
+                                                         about: (g.description ?? "").plainText, members: [])
+                info.members.append(p)
+                byId[g.id] = info
+            }
+        }
+        return byId.values.sorted {
+            let a = $0.members.contains { $0.id == myId }, b = $1.members.contains { $0.id == myId }
+            if a != b { return a }
+            return $0.name.localizedStandardCompare($1.name) == .orderedAscending
+        }
+    }
+
+    private var shown: [CourseGroupInfo] {
+        let all = allGroups
+        guard !query.isEmpty else { return all }
+        return all.filter { g in
+            g.name.localizedCaseInsensitiveContains(query)
+                || g.members.contains { $0.fullname.localizedCaseInsensitiveContains(query) }
+        }
+    }
+
+    private func siteURL(_ path: String) -> URL {
+        var c = URLComponents(url: Site.url.appendingPathComponent(path), resolvingAgainstBaseURL: false)
+        c?.queryItems = [URLQueryItem(name: "id", value: String(courseId))]
+        return c?.url ?? Site.url
+    }
+
+    var body: some View {
+        ScrollView {
+            VStack(spacing: 12) {
+                manageCard
+
+                TextField("Search groups or members", text: $query)
+                    .foregroundColor(Theme.txt).padding(12)
+                    .background(Theme.surface).clipShape(RoundedRectangle(cornerRadius: 10))
+                    .overlay(RoundedRectangle(cornerRadius: 10).stroke(Theme.line))
+
+                if let error { Text(error).font(Theme.font(.footnote)).foregroundColor(Theme.muted) }
+
+                ForEach(shown) { g in groupCard(g) }
+
+                if !loading && error == nil && shown.isEmpty {
+                    Text(query.isEmpty ? "This course has no groups you can see."
+                                       : "No group or member matches \"\(query)\".")
+                        .font(Theme.font(.footnote)).foregroundColor(Theme.muted)
+                        .frame(maxWidth: .infinity).padding(.top, 8)
+                }
+                if loading { ProgressView().tint(Theme.accent) }
+            }
+            .padding(16)
+        }
+        .task {
+            do { people = try await MoodleAPI.shared.call("core_enrol_get_enrolled_users", ["courseid": courseId]) }
+            catch {
+                if !(error is CancellationError) {
+                    self.error = "Groups aren't available for this course (\(error.localizedDescription))"
+                }
+            }
+            loading = false
+        }
+    }
+
+    // Manage groups / overview: the website's own pages
+    private var manageCard: some View {
+        VStack(spacing: 0) {
+            manageRow("Manage groups", "person.3", "group/index.php", showDivider: true)
+            manageRow("Groups overview", "list.bullet.rectangle", "group/overview.php", showDivider: true)
+            manageRow("Auto-create groups", "wand.and.stars", "group/autogroup.php", showDivider: false)
+        }
+        .glowCard()
+    }
+
+    private func manageRow(_ title: String, _ icon: String, _ path: String, showDivider: Bool) -> some View {
+        NavigationLink {
+            WebActivityView(url: siteURL(path), title: title)
+        } label: {
+            HStack(spacing: 12) {
+                Image(systemName: icon).foregroundColor(Theme.accent).frame(width: 24)
+                Text(title).foregroundColor(Theme.txt)
+                Spacer()
+                Image(systemName: "chevron.right").font(Theme.font(.caption)).foregroundColor(Theme.muted)
+            }
+            .padding(12)
+            .contentShape(Rectangle())
+            .overlay(Rectangle().fill(Theme.line).frame(height: showDivider ? 1 : 0), alignment: .bottom)
+        }
+        .buttonStyle(.plain)
+    }
+
+    private func groupCard(_ g: CourseGroupInfo) -> some View {
+        let mine = g.members.contains { $0.id == myId }
+        let expanded = open.contains(g.id) || !query.isEmpty
+        return VStack(spacing: 0) {
+            Button {
+                withAnimation(.easeInOut(duration: 0.2)) {
+                    if open.contains(g.id) { open.remove(g.id) } else { open.insert(g.id) }
+                }
+            } label: {
+                HStack(spacing: 10) {
+                    VStack(alignment: .leading, spacing: 3) {
+                        Text(g.name).fontWeight(.semibold).foregroundColor(Theme.txt)
+                            .multilineTextAlignment(.leading)
+                        Text("\(g.members.count) member\(g.members.count == 1 ? "" : "s")")
+                            .font(Theme.font(.caption)).foregroundColor(Theme.muted)
+                    }
+                    Spacer()
+                    if mine {
+                        Text("My group")
+                            .font(Theme.font(.caption2).weight(.bold)).foregroundColor(Theme.onAccent)
+                            .padding(.horizontal, 8).padding(.vertical, 3)
+                            .background(Theme.accent).clipShape(Capsule())
+                    }
+                    Image(systemName: expanded ? "chevron.up" : "chevron.down")
+                        .font(Theme.font(.caption)).foregroundColor(Theme.muted)
+                }
+                .padding(12)
+                .contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+
+            if expanded {
+                if !g.about.isEmpty {
+                    Text(g.about).font(Theme.font(.footnote)).foregroundColor(Theme.muted)
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .padding(.horizontal, 12).padding(.bottom, 8)
+                }
+                ForEach(g.members.sorted { $0.fullname < $1.fullname }) { p in
+                    NavigationLink {
+                        UserProfileView(userid: p.id, courseId: courseId, name: p.fullname,
+                                        imageURL: p.profileimageurlsmall)
+                    } label: {
+                        HStack(spacing: 12) {
+                            AsyncImage(url: p.profileimageurlsmall.flatMap { MoodleAPI.shared.fileURL($0) }) { i in
+                                i.resizable().scaledToFill()
+                            } placeholder: { Theme.surface2 }
+                            .frame(width: 30, height: 30).clipShape(Circle())
+                            Text(p.fullname).foregroundColor(Theme.txt)
+                            Spacer()
+                            Image(systemName: "chevron.right").font(Theme.font(.caption)).foregroundColor(Theme.muted)
+                        }
+                        .padding(.horizontal, 12).padding(.vertical, 8)
+                        .contentShape(Rectangle())
+                        .overlay(Rectangle().fill(Theme.line).frame(height: 1), alignment: .top)
+                    }
+                    .buttonStyle(.plain)
+                }
+            }
+        }
+        .glowCard()
+    }
+}
